      "Bash(sudo:*)"
    ],
    "deny": [
      "mcp__plugin_playwright_playwright__*",
      "Skill(mattpocock-skills:to-spec)",
      "Skill(mattpocock-skills:to-tickets)",
      "Skill(mattpocock-skills:implement)"
    ]
