{
  "effortLevel": "medium",
  "outputStyle": "ELI5",
  "autoCompactWindow": 200000,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "/bin/sh ~/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/inbox"
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Local git commands are allowed: status, diff, log, show, fetch, pull, add, commit, checkout, switch, restore, branch, merge, rebase, cherry-pick, stash, tag, reset, clean, and submodule.",
      "git worktree add, list, prune, and remove are allowed, including deleting the worktree folder, when the worktree has no uncommitted changes.",
      "Deleting local git branches (git branch -d or -D) is allowed.",
      "git push is allowed to the user's own feature branches, including --force-with-lease on them. Pushing to main, master, or other shared branches is not covered.",
      "gh CLI commands for pull requests and issues are allowed: view, list, create, edit, checkout, diff, and comment."
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(tsx:*)",
      "Bash(ts-node:*)",
      "Bash(tsc:*)",
      "Bash(jest:*)",
      "Bash(vitest:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(turbo:*)",
      "Bash(vite:*)",
      "Bash(webpack:*)",
      "Bash(esbuild:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ag:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
