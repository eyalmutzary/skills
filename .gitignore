# Whitelist: ignore everything at the repo root, then un-ignore what we want.
# To include another folder later (e.g. commands/), add:
#   !commands/

/*
!.gitignore
!README.md
!CLAUDE.md
!skills/
!scripts/
!output-styles/
!settings-public.json
!statusline-command.sh
!statusline/
!.claude-plugin/
!.claude-plugin/**
!mods/
!assets/
!hooks/
hooks/rtk-rewrite.sh
mods/*/.claude-plugin/types/

# Junk inside allowed folders
**/.DS_Store
**/.venv/
**/__pycache__/
**/*.pyc
**/node_modules/
**/.git/
